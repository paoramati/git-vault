#!/usr/bin/env bash
# git-vault: keep a git repository local and backed up.
# Runs as `git vault <command>` when this file is on PATH.
# Target: Git Bash on Windows (Git for Windows). Should also run on Linux/macOS bash.
set -euo pipefail

VAULT_VERSION="0.0.1"

# Resolve the real path of this script (following symlinks) to find lib/.
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" == /* ]] || _src="$_dir/$_src"
done
VAULT_LIB="$(cd -P "$(dirname "$_src")" && pwd)/lib"
unset _src _dir

# shellcheck source=lib/common.sh
source "$VAULT_LIB/common.sh"

usage() {
  cat <<'EOF'
usage: git vault <command> [options]

Commands:
  lock                 Disable pushing from this repository
  unlock               Restore pushing
  status               Show lock state and last backup
  backup <dest>        Write a verified bundle of all history to <dest>
  restore <src> <dir>  Clone the newest valid bundle in <src> into <dir>
  schedule <dest>      Run backups on a schedule (Windows Task Scheduler)
  doctor               Check that locking and backups are healthy
  version              Print the version
  help                 Show this help
EOF
}

cmd_version() { printf 'git-vault %s\n' "$VAULT_VERSION"; }

main() {
  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    version|--version|-v) cmd_version; return ;;
    help|--help|-h)       usage; return ;;
  esac
  # Command names are lowercase words; this also blocks path tricks like ../x.
  if [[ "$cmd" =~ ^[a-z][a-z]*$ && -f "$VAULT_LIB/cmd_$cmd.sh" ]]; then
    # shellcheck source=/dev/null
    source "$VAULT_LIB/cmd_$cmd.sh"
    "cmd_$cmd" "$@"
  else
    usage >&2; die "unknown command: $cmd"
  fi
}

main "$@"
